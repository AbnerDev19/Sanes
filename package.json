{
  "name": "sanes-brindes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test \"tests/*.test.js\"",
    "build:pages": "vite build && node scripts/prepare-pages.mjs",
    "test:responsive": "playwright test",
    "catalog:import": "node scripts/import-supabase.mjs",
    "build:production": "node scripts/check-production.mjs && npm run build:pages",
    "format": "prettier --write src tests scripts supabase/functions vite.config.js playwright.config.js eslint.config.js",
    "format:check": "prettier --check src tests scripts supabase/functions vite.config.js playwright.config.js eslint.config.js",
    "dev:lan": "vite --host 0.0.0.0",
    "catalog:audit": "node scripts/audit-catalog.mjs",
    "lint": "eslint src",
    "check:production": "node scripts/check-production.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "vite": "^6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
